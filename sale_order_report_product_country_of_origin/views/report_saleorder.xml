<odoo>
    <template
        id="report_saleorder_document"
        inherit_id="sale.report_saleorder_document"
        priority="30"
    >
        <!-- Print the product country of origin under the line description -->
        <xpath expr="//td[@name='td_product_name']" position="inside">
            <div
                t-if="line.product_id.country_of_origin"
                name="country_of_origin"
                class="text-muted small"
            >
                Origin of Goods: <span t-field="line.product_id.country_of_origin" />
            </div>
        </xpath>
    </template>
</odoo>
