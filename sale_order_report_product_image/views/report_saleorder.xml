<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_saleorder_document_image"
        inherit_id="sale.report_saleorder_document"
    >
        <th name="th_description" position="before">
            <th name="th_image" style="width: 70px;">Image</th>
        </th>
        <td name="td_product_name" position="before">
            <td name="td_image" class="align-top" style="width: 70px;">
                <img
                    t-if="line.product_id.image_128"
                    t-att-src="image_data_uri(line.product_id.image_128)"
                    t-att-alt="line.product_id.name"
                    class="rounded"
                    style="max-width: 64px; max-height: 64px;"
                />
                <!-- if no image exists, a generic icon is expected -->
                <span
                    t-if="not line.product_id.image_128"
                    t-field="line.product_id.image_128"
                    t-options="{'widget': 'image', 'max_width': '64', 'class': 'rounded'}"
                />
            </td>
        </td>
        <!--
            The picture is an extra column the standard colspans do not account for, so the
            section and combo totals are printed one column to the left. Widen them by one.
        -->
        <xpath expr="//t[@t-set='section_name_colspan']" position="attributes">
            <attribute
                name="t-value"
            >4 + (1 if display_discount else 0) + (1 if display_taxes else 0)</attribute>
        </xpath>
        <xpath expr="//td[@name='td_combo_name']" position="attributes">
            <attribute
                name="t-att-colspan"
            >4 + (1 if display_discount else 0) + (1 if display_taxes else 0)</attribute>
        </xpath>
    </template>
</odoo>
