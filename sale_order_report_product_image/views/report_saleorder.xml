<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="report_saleorder_document_image"
        inherit_id="sale.report_saleorder_document"
    >
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_image">Image</th>
        </xpath>

        <xpath expr="//td[@name='td_product_name']" position="before">
            <td name="td_image">
                <t t-if="line.product_id.image_128">
                    <span
                        t-field="line.product_id.image_128"
                        t-options="{'widget': 'image', 'max_width': '64', 'class': 'rounded'}"
                    />
                </t>
                <!-- if no image exists, a generic icon is expected -->
                <t t-if="not line.product_id.image_128">
                    <span
                        t-field="line.product_id.image_128"
                        t-options="{'widget': 'image', 'max_width': '64', 'class': 'rounded'}"
                    />
                </t>
            </td>
        </xpath>
    </template>
</odoo>
