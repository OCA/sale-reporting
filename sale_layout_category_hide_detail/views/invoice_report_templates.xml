<odoo>
    <template
        id="report_invoice_document_hide_detail"
        inherit_id="account.report_invoice_document"
    >
        <xpath expr="//t[@t-if='is_section']" position="inside">
            <t
                t-set="show_section_total"
                t-value="(line.show_details and line.show_subtotal) or (not line.show_details and line.show_section_subtotal)"
            />
        </xpath>

        <xpath
            expr="//t[@name='account_invoice_line_accountable']"
            position="attributes"
        >
            <attribute
                name="t-if"
                add="(not current_section or current_section.show_details)"
                separator=" and "
            />
        </xpath>

        <xpath expr="//t[@t-elif='is_note']" position="attributes">
            <attribute
                name="t-if"
                add="(not current_section or current_section.show_details)"
                separator=" and "
            />
        </xpath>

        <xpath
            expr='//t[@t-elif="line.display_type in (&apos;line_section&apos;, &apos;line_subsection&apos;)"]//td[@colspan=&apos;1&apos;]'
            position="attributes"
        >
            <attribute name="t-if" add="show_section_total" separator=" and " />
        </xpath>

        <xpath expr="//td[@name='td_price_unit']" position="attributes">
            <attribute
                name="t-if"
                add="(not current_section or current_section.show_line_amount)"
                separator=" and "
            />
        </xpath>
        <xpath expr="//td[@name='td_discount']" position="attributes">
            <attribute
                name="t-if"
                add="(not current_section or current_section.show_line_amount)"
                separator=" and "
            />
        </xpath>
        <xpath expr="//td[@name='td_taxes']" position="attributes">
            <attribute
                name="t-if"
                add="(not current_section or current_section.show_line_amount)"
                separator=" and "
            />
        </xpath>
        <xpath expr="//td[@name='td_subtotal']" position="attributes">
            <attribute
                name="t-if"
                add="(not current_section or current_section.show_line_amount)"
                separator=" and "
            />
        </xpath>
    </template>
</odoo>
