<odoo>
    <template
        id="report_saleorder_document_hide_detail"
        inherit_id="sale.report_saleorder_document"
    >
        <xpath expr="//t[@t-set='show_section_total']" position="after">
            <t
                t-set="show_section_total"
                t-value="show_section_total and ((line.show_details and line.show_subtotal) or (not line.show_details and line.show_section_subtotal))"
            />
        </xpath>

        <xpath expr="//tr[@name='tr_section']" position="attributes">
            <attribute
                name="t-if"
            >is_section or (is_subsection and current_section.show_details)</attribute>
        </xpath>

        <xpath expr="//tr[@name='tr_note']" position="attributes">
            <attribute
                name="t-elif"
                add="(not current_section or current_section.show_details)"
                separator=" and "
            />
        </xpath>

        <xpath expr="//td[@name='td_combo_price']" position="attributes">
            <attribute
                name="t-if"
                add="(not current_section or current_section.show_details)"
                separator=" and "
            />
        </xpath>

        <xpath expr="//tr[@name='tr_product']" position="attributes">
            <attribute
                name="t-if"
                add="(not current_section or current_section.show_details)"
                separator=" and "
            />
        </xpath>
        <xpath expr="//td[@name='td_product_priceunit']" position="attributes">
            <attribute
                name="t-if"
                add="(not current_section or current_section.show_line_amount)"
                separator=" and "
            />
        </xpath>
        <xpath expr="//td[@name='td_product_discount']" position="attributes">
            <attribute
                name="t-if"
                add="(not current_section or current_section.show_line_amount)"
                separator=" and "
            />
        </xpath>
        <xpath expr="//td[@name='td_product_taxes']" position="attributes">
            <attribute
                name="t-if"
                add="(not current_section or current_section.show_line_amount)"
                separator=" and "
            />
        </xpath>
        <xpath expr="//td[@name='td_product_subtotal']" position="attributes">
            <attribute
                name="t-if"
                add="(not current_section or current_section.show_line_amount)"
                separator=" and "
            />
        </xpath>
    </template>
</odoo>
