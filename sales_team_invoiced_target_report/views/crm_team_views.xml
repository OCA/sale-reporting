<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="crm_team_view_kanban_dashboard_reporting" model="ir.ui.view">
        <field name="name">crm.team.view.kanban.dashboard.reporting</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_kanban_dashboard" />
        <field name="mode">primary</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//templates" position="before">
                <field name="quotations_count" />
                <field name="quotations_amount" />
                <field name="sales_to_invoice_count" />
                <field name="dashboard_graph_data" />
                <field name="invoiced" />
                <field name="invoiced_target" />
                <field name="currency_id" />
            </xpath>
            <xpath
                expr="//t[@t-name='card']/div[hasclass('crm_team_kanban_bottom')]"
                position="attributes"
            >
                <attribute name="class" add="d-none" />
            </xpath>
            <xpath
                expr="//t[@t-name='card']/div[hasclass('crm_team_kanban_bottom')]"
                position="before"
            >
                <div class="px-2 mt-3 o_crm_team_dashboard_content">
                    <div class="row gx-1">
                        <div class="col-12">
                            <div
                                class="row"
                                t-if="record.lead_unassigned_count.raw_value"
                            >
                                <a
                                    class="col-8"
                                    name="%(crm.crm_case_form_view_salesteams_lead)d"
                                    type="action"
                                    context="{'search_default_unassigned_leads': 1}"
                                >
                                    <field name="lead_unassigned_count" class="me-1" />
                                    <t
                                        t-if="record.lead_unassigned_count.raw_value == 1"
                                    >Unassigned Lead</t>
                                    <t t-else="">Unassigned Leads</t>
                                </a>
                            </div>
                            <div
                                class="row"
                                t-if="record.opportunities_count.raw_value"
                            >
                                <a
                                    class="col-8"
                                    name="%(crm.crm_case_form_view_salesteams_opportunity)d"
                                    type="action"
                                    context="{'search_default_open_opportunities': True}"
                                >
                                    <field name="opportunities_count" class="me-1" />
                                    <t
                                        t-if="record.opportunities_count.raw_value == 1"
                                    >Open Opportunity</t>
                                    <t t-else="">Open Opportunities</t>
                                </a>
                                <div class="col-4 text-end text-truncate">
                                    <field
                                        name="opportunities_amount"
                                        widget="monetary"
                                        options="{'currency_field': 'currency_id'}"
                                    />
                                </div>
                            </div>
                            <div
                                class="row"
                                t-if="record.opportunities_overdue_count.raw_value"
                            >
                                <a
                                    class="col-8"
                                    name="%(crm.crm_lead_action_team_overdue_opportunity)d"
                                    type="action"
                                >
                                    <field
                                        name="opportunities_overdue_count"
                                        class="me-1"
                                    />
                                    <t
                                        t-if="record.opportunities_overdue_count.raw_value == 1"
                                    >Overdue Opportunity</t>
                                    <t t-else="">Overdue Opportunities</t>
                                </a>
                                <div class="col-4 text-end text-truncate">
                                    <field
                                        name="opportunities_overdue_amount"
                                        widget="monetary"
                                        options="{'currency_field': 'currency_id'}"
                                    />
                                </div>
                            </div>
                            <div class="row" t-if="record.quotations_count.raw_value">
                                <a
                                    class="col"
                                    name="%(sale.action_quotations_salesteams)d"
                                    type="action"
                                    context="{
                                    'search_default_draft': True,
                                    'search_default_sent': True
                                }"
                                >
                                    <field name="quotations_count" class="me-1" />
                                    <t
                                        t-if="record.quotations_count.raw_value == 1"
                                    >Quotation</t>
                                    <t t-else="">Quotations</t>
                                </a>
                                <div class="col-auto text-truncate">
                                    <field
                                        name="quotations_amount"
                                        widget="monetary"
                                        options="{
                                        'currency_field': 'currency_id'
                                    }"
                                    />
                                </div>
                            </div>
                            <div
                                class="row"
                                t-if="record.sales_to_invoice_count.raw_value"
                            >
                                <a
                                    class="col"
                                    name="%(sale.action_orders_to_invoice_salesteams)d"
                                    type="action"
                                >
                                    <field name="sales_to_invoice_count" class="me-1" />
                                    <t
                                        t-if="record.sales_to_invoice_count.raw_value == 1"
                                    >Order to Invoice</t>
                                    <t t-else="">Orders to Invoice</t>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div
                        t-if="record.dashboard_graph_data.raw_value"
                        class="o_sales_team_kanban_graph_section mt-3"
                    >
                        <field
                            name="dashboard_graph_data"
                            widget="dashboard_graph"
                            graph_type="bar"
                        />
                    </div>
                </div>
            </xpath>
            <xpath
                expr="//t[@t-name='card']/div[hasclass('crm_team_kanban_bottom')]"
                position="after"
            >
                <t groups="sales_team.group_sale_manager">
                    <div class="o_dashboard_bottom_block ps-2 pe-2 oe_kanban_action">
                        <field
                            name="invoiced"
                            widget="sales_team_progressbar"
                            title="Invoicing"
                            options="{
                                'current_value': 'invoiced',
                                'max_value': 'invoiced_target',
                                'editable': true,
                                'edit_max_value': true,
                                'on_change': 'update_invoiced_target'
                            }"
                        />
                    </div>
                </t>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="crm_team_reporting_action" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">crm.team</field>
        <field name="view_mode">kanban,form</field>
        <field name="context">{'in_sales_app': True}</field>
    </record>

    <record id="crm_team_reporting_action_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="crm_team_view_kanban_dashboard_reporting" />
        <field name="act_window_id" ref="crm_team_reporting_action" />
    </record>

    <menuitem
        id="crm_team_reporting_menu"
        name="Teams"
        parent="crm.crm_menu_report"
        action="crm_team_reporting_action"
        sequence="5"
    />
</odoo>
